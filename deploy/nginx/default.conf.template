resolver 127.0.0.11 valid=5s ipv6=off;
resolver_timeout 3s;

log_format upstream_requests '$request_method $uri $status '
                             'upstream=$upstream_addr upstream_status=$upstream_status';

upstream ingest_http {
    zone ingest_http 64k;
    server ingest:${HTTP_PORT} resolve fail_timeout=5s;
    keepalive 512;
}

upstream ingest_grpc {
    zone ingest_grpc 64k;
    least_conn;
    server ingest:${GRPC_PORT} resolve fail_timeout=5s;
}

upstream analytics_http {
    zone analytics_http 64k;
    least_conn;
    server analytics:${HTTP_PORT} resolve fail_timeout=5s;
}

server {
    listen 80;
    access_log /var/log/nginx/access.log upstream_requests;
    client_max_body_size 2m;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 3s;

    location = /v1/logs {
        proxy_pass http://ingest_http;
    }

    location = /v1/auth {
        proxy_pass http://analytics_http;
    }

    location /v1/analytics/ {
        proxy_pass http://analytics_http;
        proxy_buffering off;
        proxy_read_timeout 75s;
    }

    location / {
        return 404;
    }
}

server {
    listen 50051;
    access_log /var/log/nginx/access.log upstream_requests;
    http2 on;
    client_max_body_size 0;
    grpc_connect_timeout 3s;
    grpc_send_timeout 1h;
    grpc_read_timeout 1h;

    location / {
        grpc_pass grpc://ingest_grpc;
    }
}
